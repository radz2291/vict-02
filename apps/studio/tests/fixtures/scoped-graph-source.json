{
  "schema": "vict.ui-document@1",
  "id": "nested-composition",
  "revision": "1",
  "root": "outer-workspace",
  "nodes": {
    "application": {
      "kind": "element",
      "id": "application",
      "tag": "section",
      "children": ["app-title", "viewport", "compact-actions"],
      "attributes": {
        "aria-label": "Research notebook"
      }
    },
    "app-title": {
      "kind": "text",
      "id": "app-title",
      "content": {
        "type": "literal",
        "value": "Check evidence before approving"
      }
    },
    "compact-actions": {
      "kind": "element",
      "id": "compact-actions",
      "tag": "div",
      "children": ["rename", "undo"],
      "attributes": {
        "aria-label": "App chosen actions"
      }
    },
    "rename": {
      "kind": "component",
      "id": "rename",
      "definitionId": "vict.catalog.button",
      "revision": "1",
      "props": {
        "label": {
          "type": "literal",
          "value": "Name primary source"
        },
        "disabled": {
          "type": "ref",
          "path": "prop.readOnly"
        }
      },
      "outputs": {
        "press": {
          "emit": {
            "output": "operation",
            "value": {
              "type": "literal",
              "value": "[{\"type\":\"setLabel\",\"nodeId\":\"source-a\",\"label\":\"Named source\"}]"
            }
          }
        }
      }
    },
    "undo": {
      "kind": "component",
      "id": "undo",
      "definitionId": "vict.catalog.button",
      "revision": "1",
      "props": {
        "label": {
          "type": "literal",
          "value": "Undo local change"
        },
        "disabled": {
          "type": "ref",
          "path": "prop.readOnly"
        }
      },
      "outputs": {
        "press": {
          "emit": {
            "output": "undo"
          }
        }
      }
    },
    "viewport": {
      "kind": "component",
      "id": "viewport",
      "definitionId": "vict.flow.viewport",
      "revision": "2",
      "props": {
        "height": {
          "type": "literal",
          "value": 420
        },
        "label": {
          "type": "literal",
          "value": "Authored graph canvas"
        }
      }
    },
    "families": {
      "kind": "conditional",
      "id": "families",
      "branches": [
        {
          "when": "source",
          "children": ["source-card"]
        },
        {
          "when": "gate",
          "children": ["gate-card"]
        }
      ]
    },
    "source-card": {
      "kind": "element",
      "id": "source-card",
      "tag": "article",
      "children": ["source-title", "source-description", "source-link", "source-out"],
      "attributes": {
        "aria-label": {
          "type": "ref",
          "path": "prop.label"
        }
      },
      "localStyle": [
        {
          "property": "width",
          "value": {
            "type": "text",
            "value": "340px"
          }
        },
        {
          "property": "padding",
          "value": {
            "type": "text",
            "value": "var(--vict-space-3,12px)"
          }
        },
        {
          "property": "background-color",
          "value": {
            "type": "text",
            "value": "var(--vict-color-surface)"
          }
        },
        {
          "property": "color",
          "value": {
            "type": "text",
            "value": "var(--vict-color-text)"
          }
        },
        {
          "property": "border",
          "value": {
            "type": "text",
            "value": "1px solid var(--vict-color-border)"
          }
        }
      ]
