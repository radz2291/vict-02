    "source-title": {
      "kind": "element",
      "id": "source-title",
      "tag": "header",
      "children": ["source-title-label"],
      "classes": ["vict-graph-drag-handle"]
    },
    "source-title-label": {
      "kind": "text",
      "id": "source-title-label",
      "content": {
        "type": "expression",
        "expression": {
          "type": "ref",
          "path": "prop.label"
        }
      }
    },
    "source-description": {
      "kind": "text",
      "id": "source-description",
      "content": {
        "type": "literal",
        "value": "Keep the source address with the evidence."
      }
    },
    "source-link": {
      "kind": "element",
      "id": "source-link",
      "tag": "input",
      "children": [],
      "attributes": {
        "type": "text",
        "aria-label": "Evidence URL",
        "value": {
          "type": "ref",
          "path": "state.text"
        },
        "disabled": {
          "type": "ref",
          "path": "prop.readOnly"
        }
      },
      "classes": ["vict-input", "nodrag", "nopan", "nowheel"],
      "interactions": [
        {
          "on": "change",
          "action": "setState",
          "key": "text",
          "value": {
            "type": "literal",
            "value": ""
          }
        }
      ]
    },
    "source-out": {
      "kind": "component",
      "id": "source-out",
      "definitionId": "vict.flow.port",
      "revision": "2",
      "props": {
        "id": {
          "type": "literal",
          "value": "result"
        }
      },
      "slots": {
        "content": {
          "name": "content",
          "children": ["source-caption"]
        }
      }
    },
    "source-caption": {
      "kind": "text",
      "id": "source-caption",
      "content": {
        "type": "literal",
        "value": "Send evidence to a review gate"
