{
  "name": "@victframework/appdata-sqlite",
  "version": "0.1.0",
  "type": "module",
  "description": "Production SQLite application-domain data adapter for the neutral Application Data port, with a separate versioned application-domain migration API. Uses the built-in node:sqlite driver. Application-domain tables and migrations are structurally separate from Vict operational stores.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@victframework/application": "0.1.0",
    "@victframework/contracts": "0.1.0",
    "@victframework/sdk": "0.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/appdata-sqlite"
  },
  "bugs": {
    "url": "https://github.com/radz2291/vict-02/issues"
  },
  "homepage": "https://github.com/radz2291/vict-02#readme"
}
