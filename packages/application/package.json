{
  "name": "@victframework/application",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-neutral Application Definition compiler, canonical identity, release manifests, renderer contract, and application-data adapter contracts with shared conformance fixtures. Depends only on @victframework/contracts and @victframework/sdk — never on the runtime or a UI framework.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@victframework/contracts": "0.1.0",
    "@victframework/sdk": "0.1.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/application"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/radz2291/vict-02/issues"
  },
  "homepage": "https://github.com/radz2291/vict-02#readme"
}
