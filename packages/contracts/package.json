{
  "name": "@victframework/contracts",
  "version": "0.1.0",
  "type": "module",
  "description": "Neutral executable input/output promises and structured validation results for Vict graphs. Schema-library adapters are optional subpaths.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "default": "./dist/zod/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/contracts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/radz2291/vict-02/issues"
  },
  "homepage": "https://github.com/radz2291/vict-02#readme"
}
