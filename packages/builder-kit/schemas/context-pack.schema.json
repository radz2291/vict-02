{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vict.dev/schemas/builder-kit/context-pack@1.json",
  "title": "vict.builder.context-pack@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaMarker",
    "packId",
    "generatedFrom",
    "constitution",
    "repositoryMap",
    "verifiedBaseline",
    "toolManifestRef",
    "permissionProfilesRef",
    "verificationCommands",
    "stopConditions"
  ],
  "properties": {
    "schemaMarker": { "const": "vict.builder.context-pack@1" },
    "packId": { "$ref": "#/$defs/sha256" },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceVersion", "releaseSetId", "workspaceIdentity", "inputs"],
      "properties": {
        "referenceVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "releaseSetId": { "type": "string", "pattern": "^vict-release-set@1/" },
        "workspaceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "workspaces"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "workspaces": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "contentSha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "contentSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "constitution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "anchor", "contentSha256", "excerpt"],
        "properties": {
          "sourcePath": { "type": "string", "minLength": 1 },
          "anchor": { "type": "string", "minLength": 1 },
          "contentSha256": { "$ref": "#/$defs/sha256" },
          "excerpt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "repositoryMap": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "main",
          "types",
          "private",
          "internalDependencies",
          "externalDependencies"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "main": { "type": "string", "minLength": 1 },
          "types": { "type": "string", "minLength": 1 },
          "private": { "type": "boolean" },
          "internalDependencies": { "type": "array", "items": { "type": "string" } },
          "externalDependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "verifiedBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "anchor", "contentSha256", "extract"],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "extract": { "type": "string", "minLength": 1 }
      }
    },
    "toolManifestRef": { "$ref": "#/$defs/protocolRef" },
    "permissionProfilesRef": { "$ref": "#/$defs/protocolRef" },
    "verificationCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protocolRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaMarker", "sourcePath", "contentSha256"],
      "properties": {
        "schemaMarker": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
