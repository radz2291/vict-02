{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vict.dev/schemas/builder-kit/catalog@1.json",
  "title": "vict.builder.catalog@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaMarker", "generatedFrom", "packs"],
  "properties": {
    "schemaMarker": { "const": "vict.builder.catalog@1" },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceModules"],
      "properties": {
        "sourceModules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "module", "contentSha256"],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "module": { "type": "string", "minLength": 1 },
              "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "victCompatibility", "capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "victCompatibility": { "type": "string", "minLength": 1 },
          "documentation": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["summary"],
            "properties": { "summary": { "type": "string" } }
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "revision"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "minLength": 1 }
              }
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "configuration": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "description": { "type": "string", "minLength": 1 },
                "sensitive": { "type": "boolean" }
              }
            }
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "doubles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capabilityId", "revision"],
              "properties": {
                "capabilityId": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "minLength": 1 },
                "modes": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["test", "simulate"] }
                }
              }
            }
          },
          "evaluations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "capabilityId"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "capabilityId": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "provenance": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "author": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "revision", "effect", "summary", "module", "contentSha256"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "minLength": 1 },
                "effect": { "enum": ["pure", "read", "write", "irreversible"] },
                "input": { "$ref": "#/$defs/contractRef" },
                "output": { "$ref": "#/$defs/contractRef" },
                "summary": { "enum": [null] },
                "idempotency": { "const": "keyed" },
                "retry": { "type": "object" },
                "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "configuration": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "requiredConfiguration": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "secrets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "requiredSecrets": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "ambiguity": { "enum": ["block", "keyedRetry"] },
                "module": { "type": "string", "minLength": 1 },
                "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "contractRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["contractId", "revision"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    }
  }
}
