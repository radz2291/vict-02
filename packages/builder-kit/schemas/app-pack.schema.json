{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vict.dev/schemas/builder-kit/app-pack@1.json",
  "title": "vict.builder.app-pack@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaMarker",
    "packId",
    "app",
    "generatedFrom",
    "permissionProfile",
    "verificationCommands",
    "stopConditions"
  ],
  "properties": {
    "schemaMarker": { "const": "vict.builder.app-pack@1" },
    "packId": { "$ref": "#/$defs/sha256" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseSetId", "kitArtifact", "inputs"],
      "properties": {
        "releaseSetId": { "type": "string", "pattern": "^vict-release-set@1/" },
        "kitArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec", "sha256"],
          "properties": {
            "spec": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "contentSha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "contentSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "permissionProfile": {
      "type": "string",
      "enum": ["builder.read", "builder.change", "builder.selfhost"]
    },
    "verificationCommands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
