{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vict.dev/schemas/builder-kit/task-pack@1.json",
  "title": "vict.builder.task-pack@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaMarker",
    "packId",
    "basePackId",
    "basePackPath",
    "handoff",
    "baseTree",
    "inScopePaths",
    "ignoreManifest",
    "ignoreManifestDigest",
    "permissionProfile"
  ],
  "properties": {
    "schemaMarker": { "const": "vict.builder.task-pack@1" },
    "packId": { "$ref": "#/$defs/sha256" },
    "basePackId": { "$ref": "#/$defs/sha256" },
    "basePackPath": { "type": "string", "minLength": 1 },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseTree": { "$ref": "#/$defs/gitSha" },
    "inScopePaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "ignoreManifest": { "type": "array", "items": { "type": "string" } },
    "ignoreManifestDigest": { "$ref": "#/$defs/sha256" },
    "permissionProfile": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}
