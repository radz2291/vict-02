{
  "name": "@victframework/mastra",
  "version": "0.2.0",
  "type": "module",
  "description": "Optional Mastra-backed implementation of the neutral VICT ProductAgent boundary: pinned Mastra versions, deterministic offline model fixture, pure helper-tool enforcement, dedicated file-backed Mastra storage, payload-safe tracing, and governed memory lifecycle. Imports the neutral VICT packages; never imported by them.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mastra/core": "1.64.0",
    "@mastra/libsql": "1.22.3",
    "@mastra/memory": "1.28.2",
    "@mastra/observability": "1.17.5",
    "zod": "^3.25.76",
    "@victframework/contracts": "0.2.0",
    "@victframework/kernel": "0.2.0",
    "@victframework/runtime": "0.2.0",
    "@victframework/sdk": "0.2.0",
    "@victframework/control": "0.2.0"
  },
  "devDependencies": {
    "@victframework/store-sqlite": "0.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/mastra"
  },
  "bugs": {
