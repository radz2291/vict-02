{
  "name": "@victframework/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Vict typed operator/developer CLI. Consumes the same versioned VICT command surface as HTTP (never SQLite directly); thin, Mastra-free, browser-independent.",
  "bin": {
    "vict": "./bin/vict.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@victframework/server": "0.1.1"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/radz2291/vict-02/issues"
  },
  "homepage": "https://github.com/radz2291/vict-02#readme"
}
