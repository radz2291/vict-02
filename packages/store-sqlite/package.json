{
  "name": "@vict/store-sqlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite adapter for Vict's semantic store ports: activation catalog, execution store, forward migrations. Uses the built-in node:sqlite driver.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vict/runtime": "0.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
