{
  "name": "@victframework/renderer-svelte",
  "version": "0.3.1",
  "type": "module",
  "description": "Compatibility facade for the Vict Svelte renderer: re-exports the canonical ApplicationRenderer API from @victframework/ui-svelte so existing consumers keep working. Contains NO independent renderer implementation — the permanent implementation (VitApp, surface traversal, adapters, mount machinery, form values, styles) lives only in @victframework/ui-svelte.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "main": "./src/index.ts",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "test": "vitest run --project renderer"
  },
  "dependencies": {
    "@victframework/ui-svelte": "0.3.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/renderer-svelte"
  },
  "bugs": {
    "url": "https://github.com/radz2291/vict-02/issues"
  },
  "homepage": "https://github.com/radz2291/vict-02#readme"
}
