{
  "name": "@victframework/renderer-svelte",
  "version": "0.2.0",
  "type": "module",
  "description": "Canonical SvelteKit renderer for Vict Application Plans: generic application host, built-in role components, responsive navigation, semantic theme tokens, and accessible defaults. Svelte and component-library dependencies live ONLY in this renderer boundary — never in @victframework/application or the base SDK.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "main": "./src/index.ts",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "test": "vitest run --project renderer"
  },
  "dependencies": {
    "@victframework/application": "0.2.0",
    "@victframework/sdk": "0.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/renderer-svelte"
  },
  "bugs": {
    "url": "https://github.com/radz2291/vict-02/issues"
  },
  "homepage": "https://github.com/radz2291/vict-02#readme"
}
