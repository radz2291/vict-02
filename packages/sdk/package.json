{
  "name": "@vict/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stable, schema-library-neutral authoring ABI for Vict: contracts, capabilities, graphs, capability packs, applications, resources and releases. Optional Zod adapter under ./zod. Has NO dependency on the runtime.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vict/contracts": "0.1.0"
  },
  "peerDependencies": {
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
