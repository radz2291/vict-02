{
  "name": "@victframework/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Stable, schema-library-neutral authoring ABI for Vict: contracts, capabilities, graphs, capability packs, applications, resources and releases. Optional Zod adapter under ./zod. Has NO dependency on the runtime.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@victframework/contracts": "0.2.0"
  },
  "peerDependencies": {
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radz2291/vict-02.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/radz2291/vict-02/issues"
  },
  "homepage": "https://github.com/radz2291/vict-02#readme"
}
