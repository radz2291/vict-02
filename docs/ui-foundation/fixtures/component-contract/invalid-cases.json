{
  "name": "invalid-cases",
  "proves": "author-time rejection of unknown outputs, invalid payloads, incompatible bindings, unknown $output placement, undeclared slots",
  "cases": [
    {
      "case": "unknown output name",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": { "checked": { "type": "ref", "path": "state.ackA" } },
          "outputs": {
            "toggled": {
              "setState": { "key": "ackA", "value": { "type": "ref", "path": "$output" } }
            }
          }
        }
      },
      "expectedCodes": ["UI_COMPONENT_OUTPUT_UNKNOWN"]
    },
    {
      "case": "payload type mismatch against target state key",
      "documentExcerpt": {
        "localState": { "count": { "key": "count", "type": "number", "initial": 0 } },
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": { "checked": { "type": "ref", "path": "state.count" } },
          "outputs": {
            "checkedChange": {
              "setState": { "key": "count", "value": { "type": "ref", "path": "$output" } }
            }
          }
        }
      },
      "expectedCodes": ["UI_COMPONENT_BINDING_INCOMPATIBLE"]
    },
    {
      "case": "invalid payload expression ($output used as a boolean in a non-binding scope is rejected; here also wrong comparison operand type)",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": {
            "label": { "type": "boolean", "value": "not-a-boolean-literal" }
          },
          "outputs": {
            "checkedChange": {
              "setState": {
                "key": "ackA",
                "value": {
                  "type": "boolean",
                  "op": "not",
                  "terms": [{ "type": "ref", "path": "$output" }]
                }
              }
            }
          }
        }
      },
      "expectedCodes": ["UI_EXPR_TYPE_MISMATCH"]
    },
    {
      "case": "$output outside an output-binding scope",
      "documentExcerpt": {
        "node": {
          "kind": "text",
          "id": "leak",
          "content": { "type": "expression", "expression": { "type": "ref", "path": "$output" } }
        }
      },
      "expectedCodes": ["UI_COMPONENT_OUTPUT_PAYLOAD_INVALID"]
    },
    {
      "case": "undeclared slot fill",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": { "checked": { "type": "ref", "path": "state.ackA" } },
          "slots": { "body": { "name": "body", "children": [] } }
        }
      },
      "expectedCodes": ["UI_DOC_UNKNOWN_COMPONENT"]
    },
    {
      "case": "unknown action id in an output binding",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "btnX",
          "definitionId": "vict.catalog.button",
          "revision": "1",
          "props": {},
          "outputs": { "press": { "invokeAction": { "actionId": "not.declared" } } }
        }
      },
      "expectedCodes": ["UI_DOC_UNKNOWN_ACTION"]
    }
  ]
}
