{
  "name": "invalid-cases",
  "proves": "author-time rejection of unknown outputs, invalid payloads, incompatible bindings, unknown $output placement, undeclared slots",
  "cases": [
    {
      "case": "unknown output name",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": {
            "checked": {
              "type": "ref",
              "path": "state.ackA"
            }
          },
          "outputs": {
            "toggled": {
              "setState": {
                "key": "ackA",
                "value": {
                  "type": "ref",
                  "path": "$output"
                }
              }
            }
          }
        }
      },
      "expectedCodes": ["UI_COMPONENT_OUTPUT_UNKNOWN"]
    },
    {
      "case": "payload type mismatch against target state key",
      "documentExcerpt": {
        "localState": {
          "count": {
            "key": "count",
            "type": "number",
            "initial": 0
          }
        },
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": {
            "checked": {
              "type": "ref",
              "path": "state.count"
            }
          },
          "outputs": {
            "checkedChange": {
              "setState": {
                "key": "count",
                "value": {
                  "type": "ref",
                  "path": "$output"
                }
              }
            }
          }
        }
      },
      "expectedCodes": ["UI_EXPR_TYPE_MISMATCH", "UI_COMPONENT_BINDING_INCOMPATIBLE"],
      "note": "prop 'checked' (boolean) bound to number-typed state key: the amended compile prop check (reference source typing) fires UI_EXPR_TYPE_MISMATCH; the output-side rule fires UI_COMPONENT_BINDING_INCOMPATIBLE"
    },
    {
      "case": "descriptor prop literal of the wrong type (compile-time, built by the amendment for descriptor instances)",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": {
            "label": {
              "type": "literal",
              "value": false
            }
          }
        }
      },
      "expectedCodes": ["UI_EXPR_TYPE_MISMATCH"]
    },
    {
      "case": "$output outside an output-binding scope",
      "documentExcerpt": {
        "node": {
          "kind": "text",
          "id": "leak",
          "content": {
            "type": "expression",
            "expression": {
              "type": "ref",
              "path": "$output"
            }
          }
        }
      },
      "expectedCodes": ["UI_COMPONENT_OUTPUT_PAYLOAD_INVALID"]
    },
    {
      "case": "undeclared slot fill",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "cbX",
          "definitionId": "vict.catalog.checkbox",
          "revision": "1",
          "props": {
            "checked": {
              "type": "ref",
              "path": "state.ackA"
            }
          },
          "slots": {
            "body": {
              "name": "body",
              "children": []
            }
          }
        }
      },
      "expectedCodes": ["UI_DOC_UNKNOWN_COMPONENT"],
      "note": "descriptor-instance undeclared slot fill: UI_DOC_UNKNOWN_COMPONENT is compile-RAISED BY THE AMENDMENT for this case (today such fills are silently dropped - amendment 3.7/5.1); the code exists today only as the validate-deferred code for stored definitions"
    },
    {
      "case": "unknown action id in an output binding",
      "documentExcerpt": {
        "node": {
          "kind": "component",
          "id": "btnX",
          "definitionId": "vict.catalog.button",
          "revision": "1",
          "props": {},
          "outputs": {
            "press": {
              "invokeAction": {
                "actionId": "not.declared"
              }
            }
          }
        }
      },
      "expectedCodes": ["UI_DOC_UNKNOWN_PRODUCT_REFERENCE"],
      "note": "existing code (validate.ts action/route catalog checks), extended by the amendment to output bindings"
    }
  ]
}
