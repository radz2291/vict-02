{
  "name": "button-declared-action",
  "proves": "intent output (void payload) -> invokeAction with authored input mapping from state; loading/disabled driven by authored state reactively",
  "descriptor": {
    "id": "vict.catalog.button",
    "revision": "1",
    "abi": "vict.ui-component-abi@1",
    "events": ["vict.ui-component-abi@1"],
    "props": [
      {
        "name": "label",
        "type": "string",
        "default": ""
      },
      {
        "name": "disabled",
        "type": "boolean",
        "default": false
      },
      {
        "name": "loading",
        "type": "boolean",
        "default": false
      }
    ],
    "outputs": [
      {
        "name": "press",
        "payload": "void",
        "description": "Fires on activation while not disabled/loading."
      }
    ],
    "rendererImplementationId": "vict.svelte.catalog"
  },
  "applicationInputs": {
    "actionIds": ["review.approve"],
    "actionInputs": {
      "review.approve": {
        "noteId": "string"
      }
    }
  },
  "documentExcerpt": {
    "localState": {
      "approving": {
        "key": "approving",
        "type": "boolean",
        "initial": false
      },
      "currentNote": {
        "key": "currentNote",
        "type": "string",
        "initial": "n_1"
      }
    },
    "nodes": {
      "approveBtn": {
        "kind": "component",
        "id": "approveBtn",
        "definitionId": "vict.catalog.button",
        "revision": "1",
        "props": {
          "label": {
            "type": "literal",
            "value": "Approve"
          },
          "loading": {
            "type": "ref",
            "path": "state.approving"
          },
          "disabled": {
            "type": "compare",
            "op": "eq",
            "left": {
              "type": "ref",
              "path": "state.currentNote"
            },
            "right": {
              "type": "literal",
              "value": ""
            }
          }
        },
        "outputs": {
          "press": {
            "invokeAction": {
              "actionId": "review.approve",
              "input": {
                "noteId": {
                  "type": "ref",
                  "path": "state.currentNote"
                }
              }
            }
          }
        }
      }
    }
  },
  "expected": "press dispatches review.approve through the host dispatcher with the authored input mapping; loading prop from state renders pending/disabled presentation; disabled expression re-evaluates when state.currentNote changes; no dispatcher ever reaches the implementation"
}
