[
 {
  "route": "queue",
  "routeLabel": "Inspection queue",
  "families": [
   {
    "family": "dropdown-menu",
    "occ": "queue-actions",
    "prop": "label",
    "value": "Queue actions R5",
    "find": "[data-ui-occ*=\"|queue-actions\"]",
    "match": {
     "text": "Queue actions R5"
    },
    "echo": "plan"
   },
   {
    "family": "tooltip",
    "occ": "priority-help",
    "prop": "title",
    "value": "Priority help R5",
    "find": "[data-ui-occ*=\"|priority-help\"]",
    "match": {
     "text": "Priority help R5"
    },
    "echo": "closed",
    "open": {
     "hover": true,
     "trigger": "[data-ui-occ*=\"|priority-help\"]",
     "portal": "[role=\"tooltip\"]"
    }
   },
   {
    "family": "avatar",
    "occ": "lead-avatar",
    "prop": "fallback",
    "value": "R5",
    "find": "[data-ui-occ*=\"|lead-avatar\"]",
    "match": {
     "text": "R5"
    }
   },
   {
    "family": "link-preview",
    "occ": "site-preview",
    "prop": "title",
    "value": "Riverside plant reference R5",
    "find": "[data-ui-occ*=\"|site-preview\"]",
    "match": {
     "text": "Riverside plant reference R5"
    },
    "echo": "closed",
    "open": {
     "hover": true,
     "trigger": "[data-ui-occ*=\"|site-preview\"]",
     "portal": "[data-link-preview-content], [role=\"tooltip\"]"
    }
   },
   {
    "family": "pagination",
    "occ": "queue-pages",
    "prop": "label",
    "value": "Queue pages R5",
    "find": "[data-ui-occ*=\"|queue-pages\"]",
    "match": {
     "attr": "aria-label",
     "contains": "Queue pages R5"
    },
    "echo": "aria"
   },
   {
    "family": "context-menu",
    "occ": "inspection-context",
    "prop": "label",
    "value": "Inspection context R5",
    "find": "[data-ui-occ*=\"|inspection-context\"]",
    "match": {
     "text": "Inspection context R5"
    },
    "echo": "plan"
   }
  ]
 },
