{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@vict/contracts": ["./packages/contracts/src/index.ts"],
      "@vict/contracts/*": ["./packages/contracts/src/*"],
      "@vict/contracts/zod": ["./packages/contracts/src/zod/index.ts"],
      "@vict/kernel": ["./packages/kernel/src/index.ts"],
      "@vict/kernel/*": ["./packages/kernel/src/*"],
      "@vict/kernel/testing": ["./packages/kernel/src/testing.ts"],
      "@vict/runtime": ["./packages/runtime/src/index.ts"],
      "@vict/runtime/*": ["./packages/runtime/src/*"],
      "@vict/runtime/testing": ["./packages/runtime/src/testing.ts"],
      "@vict/store-sqlite": ["./packages/store-sqlite/src/index.ts"],
      "@vict/appdata-sqlite": ["./packages/appdata-sqlite/src/index.ts"],
      "@vict/renderer-svelte": ["./packages/renderer-svelte/src/index.ts"],
      "@vict/scaffolder": ["./packages/scaffolder/src/index.ts"],
      "@vict/application": ["./packages/application/src/index.ts"],
      "@vict/application/*": ["./packages/application/src/*"],
      "@vict/application/testing": ["./packages/application/src/testing.ts"],
      "@vict/application/renderer": ["./packages/application/src/renderer.ts"],
      "@vict/sdk": ["./packages/sdk/src/index.ts"],
      "@vict/mastra": ["./packages/mastra/src/index.ts"],
      "@vict/sdk/*": ["./packages/sdk/src/*"],
      "@vict/sdk/zod": ["./packages/sdk/src/zod.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["examples/application-proof", "examples/reference-app"]
}
